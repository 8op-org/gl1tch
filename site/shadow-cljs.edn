{:deps true
 :nrepl {:port 7888}
 :dev-http {3000 "resources/public"}
 :builds
 {:app
  {:target :browser
   :output-dir "resources/public/js"
   :asset-path "/js"
   :modules {:main {:init-fn gl1tch.site.core/init}}
   :devtools {:after-load gl1tch.site.core/reload}}
  :test
  {:target :node-test
   :output-to "out/test.js"
   :autorun true}}}
