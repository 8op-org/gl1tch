;; std/collections — collection helpers

(def compact
  (fn (source)
    (filter source (fn (item) (not (= (trim item) ""))))))

(def first
  (fn (source)
    (pick 0 source)))

(def pluck
  (fn (key source)
    (map source (fn (item) (pick key item)))))

(def take
  (fn (n source)
    (slice source 0 n)))

(def unique
  (fn (source)
    (set source)))

(def without
  (fn (source exclude)
    (difference source exclude)))
