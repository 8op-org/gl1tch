# site-gate.glitch — C.L.E.A.R. content gate
#
# Called by site-write.glitch. Validates generated doc content.
# Params: slug, content, context
#
# C.L.E.A.R. = Clarity, Logic, Empathy, Actionability, Relevance

(import glitch/core :as g)
(import spork/json)

(g/workflow "site-gate"
  :description "C.L.E.A.R. content quality gate"

  (g/step "gate-voice"
    (g/llm
      :provider "copilot"
      :format "json"
      :prompt (string ```
        You are a documentation reviewer using the C.L.E.A.R. method.
        Review the content below for VOICE and STRUCTURE quality.

        Evaluate these dimensions:

        **C - Clarity**: Is the writing explicit and easy to follow?
        Are examples shown before explanation? No vague hand-waving?

        **L - Logic**: Does the structure make sense? Are headings
        properly nested (## then ###)? Do cross-links use valid slugs
        from the page list? Is there a logical flow from intro to details?

        **R - Relevance**: Does the content stay on-topic for the page slug?
        No scope creep into other pages? No internal implementation details
        leaking through (BubbleTea, tmux, SQLite, Go types, OTel)?

        **E - Empathy**: Review the content, not the writer. Frame any
        issues as "the content does X" not "you did X".

        PAGE SLUG: ``` (g/param "slug") ```

        CONTENT TO REVIEW:
        ``` (g/param "content") ```

        OUTPUT: A single JSON object, no markdown fence:
        {
          "pass": true,
          "issues": []
        }

        If there are problems:
        {
          "pass": false,
          "issues": [
            {"category": "C", "line": "the problematic text", "fix": "specific actionable fix"}
          ]
        }

        Only fail for real problems. Minor style preferences are not failures.
        ```)))

  (g/step "gate-accuracy"
    (g/llm
      :provider "copilot"
      :format "json"
      :prompt (string ```
        You are a documentation accuracy reviewer using the C.L.E.A.R. method.
        Verify the content below against the real repo context.

        Evaluate these dimensions:

        **L - Logic**: Does every command, flag, and code example
        actually exist in the repo context below? Are there any
        hallucinated features, invented flags, or made-up commands?

        **A - Actionability**: For each issue found, provide a specific
        fix with enough detail to act on immediately. Include what to
        replace the problematic text with.

        **R - Relevance**: No references to:
        - Ollama (dropped — LM Studio is the runtime)
        - glitch ask (decommissioned)
        - Internal Go types or package names
        - tmux, BubbleTea, SQLite, OTel

        PAGE SLUG: ``` (g/param "slug") ```

        CONTENT TO REVIEW:
        ``` (g/param "content") ```

        REPO CONTEXT (ground truth — only features shown here are real):
        ``` (g/param "context") ```

        OUTPUT: A single JSON object, no markdown fence:
        {
          "pass": true,
          "issues": []
        }

        If there are problems:
        {
          "pass": false,
          "issues": [
            {"category": "L", "line": "glitch ask --query", "fix": "glitch ask is decommissioned -- remove this example"}
          ]
        }

        Only fail for factual errors — things that are wrong, not things
        that could be better. Style is handled by the voice gate.
        ```)))

  # Merge both gate results
  (g/step "merged"
    (do
      (def voice (json/decode (g/ref "gate-voice")))
      (def accuracy (json/decode (g/ref "gate-accuracy")))
      (def all-issues (array/concat @[]
                        (or (voice "issues") @[])
                        (or (accuracy "issues") @[])))
      (def passed (and (voice "pass") (accuracy "pass")))
      (json/encode {"pass" passed "issues" all-issues}))))
