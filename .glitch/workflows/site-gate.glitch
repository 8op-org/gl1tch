;; site-gate.glitch — C.L.E.A.R. content gate
;;
;; Called by site-write.glitch. Validates generated doc content.
;; Params: slug, content, context
;;
;; C.L.E.A.R. = Clarity, Logic, Empathy, Actionability, Relevance

(workflow "site-gate"
  :description "C.L.E.A.R. content quality gate"

  (step "gate-voice"
    (llm
      :provider "copilot"
      :format "json"
      :prompt (str
        "You are a documentation reviewer using the C.L.E.A.R. method.\n"
        "Review the content below for VOICE and STRUCTURE quality.\n\n"
        "Evaluate these dimensions:\n\n"
        "**C - Clarity**: Is the writing explicit and easy to follow?\n"
        "Are examples shown before explanation? No vague hand-waving?\n\n"
        "**L - Logic**: Does the structure make sense? Are headings\n"
        "properly nested (## then ###)? Do cross-links use valid slugs\n"
        "from the page list? Is there a logical flow from intro to details?\n\n"
        "**R - Relevance**: Does the content stay on-topic for the page slug?\n"
        "No scope creep into other pages? No internal implementation details\n"
        "leaking through (BubbleTea, tmux, SQLite, Go types, OTel)?\n\n"
        "**E - Empathy**: Review the content, not the writer. Frame any\n"
        "issues as \"the content does X\" not \"you did X\".\n\n"
        "PAGE SLUG: " (param "slug") "\n\n"
        "CONTENT TO REVIEW:\n" (param "content") "\n\n"
        "OUTPUT: A single JSON object, no markdown fence:\n"
        "{\n"
        "  \"pass\": true,\n"
        "  \"issues\": []\n"
        "}\n\n"
        "If there are problems:\n"
        "{\n"
        "  \"pass\": false,\n"
        "  \"issues\": [\n"
        "    {\"category\": \"C\", \"line\": \"the problematic text\", \"fix\": \"specific actionable fix\"}\n"
        "  ]\n"
        "}\n\n"
        "Only fail for real problems. Minor style preferences are not failures.")))

  (step "gate-accuracy"
    (llm
      :provider "copilot"
      :format "json"
      :prompt (str
        "You are a documentation accuracy reviewer using the C.L.E.A.R. method.\n"
        "Verify the content below against the real repo context.\n\n"
        "Evaluate these dimensions:\n\n"
        "**L - Logic**: Does every command, flag, and code example\n"
        "actually exist in the repo context below? Are there any\n"
        "hallucinated features, invented flags, or made-up commands?\n\n"
        "**A - Actionability**: For each issue found, provide a specific\n"
        "fix with enough detail to act on immediately. Include what to\n"
        "replace the problematic text with.\n\n"
        "**R - Relevance**: No references to:\n"
        "- Ollama (dropped — LM Studio is the runtime)\n"
        "- glitch ask (decommissioned)\n"
        "- Internal Go types or package names\n"
        "- tmux, BubbleTea, SQLite, OTel\n\n"
        "PAGE SLUG: " (param "slug") "\n\n"
        "CONTENT TO REVIEW:\n" (param "content") "\n\n"
        "REPO CONTEXT (ground truth — only features shown here are real):\n"
        (param "context") "\n\n"
        "OUTPUT: A single JSON object, no markdown fence:\n"
        "{\n"
        "  \"pass\": true,\n"
        "  \"issues\": []\n"
        "}\n\n"
        "If there are problems:\n"
        "{\n"
        "  \"pass\": false,\n"
        "  \"issues\": [\n"
        "    {\"category\": \"L\", \"line\": \"glitch ask --query\", \"fix\": \"glitch ask is decommissioned -- remove this example\"}\n"
        "  ]\n"
        "}\n\n"
        "Only fail for factual errors — things that are wrong, not things\n"
        "that could be better. Style is handled by the voice gate.")))

  ;; Merge both gate results
  (step "merged"
    (let [voice (json/decode (ref "gate-voice"))
          accuracy (json/decode (ref "gate-accuracy"))
          all-issues (into [] (concat (or (get voice "issues") [])
                                      (or (get accuracy "issues") [])))
          passed (and (get voice "pass") (get accuracy "pass"))]
      (json/encode {"pass" passed "issues" all-issues}))))
