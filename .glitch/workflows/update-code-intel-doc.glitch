;; update-code-intel-doc.glitch — generate/update the code intelligence doc
;;
;; Usage:
;;   glitch run update-code-intel-doc "refresh doc with latest symbol data"
;;
;; Dogfoods the code intelligence DSL: indexes the repo, pulls real
;; symbol + call-graph data, then generates the doc grounded in that data.

(workflow "update-code-intel-doc"
  :description "Update the code intelligence documentation page"

  ;; 1. Ensure the index is fresh
  (step "reindex"
    (sh "glitch" "index" "--full"))

  ;; 2. Pull real symbol data — key functions and types
  (step "symbols-functions"
    (search-symbols {:kind "function" :language "go" :limit 30}))

  (step "symbols-types"
    (search-symbols {:kind "type" :language "go" :limit 20}))

  (step "symbols-python"
    (search-symbols {:kind "function" :language "python" :limit 20}))

  ;; 3. Pull call-graph edges
  (step "edges-calls"
    (search-edges {:kind "calls" :depth 2 :limit 30}))

  (step "edges-implements"
    (search-edges {:kind "implements" :limit 20}))

  ;; 4. Get full context for key symbols
  (step "ctx-index"
    (symbol-context "IndexRepo"))

  (step "ctx-query-symbols"
    (symbol-context "query-symbols"))

  (step "ctx-search-edges"
    (symbol-context "query-edges"))

  ;; 5. Read the design spec for feature descriptions
  (step "spec"
    (read-file "docs/superpowers/specs/2026-04-21-code-intel-bb-design.md"))

  ;; 6. Read an existing doc for voice/format reference
  (step "voice-ref"
    (read-file "site/src/content/docs/tool-use.md"))

  ;; 7. Read the current doc if it exists
  (step "current"
    (sh "bash" "-c"
      "cat site/src/content/docs/code-intelligence.md 2>/dev/null || echo '(new file)'"))

  ;; 8. Generate the doc grounded in actual indexed data + spec
  (step "draft"
    (llm
      :provider "openrouter"
      :model "google/gemini-2.5-flash"
      :tools []
      :prompt (str
        "You are writing user-facing documentation for gl1tch.\n\n"
        "DESIGN SPEC (ground truth — all claims must come from here):\n"
        (ref "spec") "\n\n"
        "VOICE/FORMAT REFERENCE (match this style exactly):\n"
        (ref "voice-ref") "\n\n"
        "CURRENT DOC:\n"
        (ref "current") "\n\n"
        "INDEXED SYMBOL DATA (real symbols from glitch index):\n"
        "Go functions:\n" (ref "symbols-functions") "\n\n"
        "Go types:\n" (ref "symbols-types") "\n\n"
        "Python functions:\n" (ref "symbols-python") "\n\n"
        "CALL GRAPH DATA (real edges from the code graph):\n"
        "Calls:\n" (ref "edges-calls") "\n\n"
        "Implements:\n" (ref "edges-implements") "\n\n"
        "KEY SYMBOL CONTEXT:\n"
        "IndexRepo:\n" (ref "ctx-index") "\n\n"
        "query-symbols:\n" (ref "ctx-query-symbols") "\n\n"
        "query-edges:\n" (ref "ctx-search-edges") "\n\n"
        "INSTRUCTIONS: " (input) "\n\n"
        "RULES:\n"
        "- Frontmatter: title 'Code Intelligence', description, order: 8\n"
        "- Voice: user-first, 'your' framing, examples before explanation\n"
        "- Every code example must use real DSL syntax from the spec\n"
        "- Never mention internals: tree-sitter, Elasticsearch field names, SHA256 hashing\n"
        "- Focus on what the user can DO, not how it works underneath\n"
        "- Keep it concise — one page, not a manual\n"
        "- Show the workflow DSL forms: search-symbols, search-edges, symbol-context\n"
        "- Use real symbol names and relationships from the INDEXED DATA above\n"
        "- Show glitch index as the entry point for indexing, glitch index query for querying\n\n"
        "Return the complete markdown file content including frontmatter.")))

  ;; 9. Grounding check against spec
  (step "verify"
    (grounded? "draft" (ref "spec")
      :provider "openrouter"
      :model "google/gemma-3-12b-it"
      :strict false))

  ;; 10. Save
  (step "save"
    (save "site/src/content/docs/code-intelligence.md" (ref "draft"))))
