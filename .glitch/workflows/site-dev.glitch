;; site-dev.glitch — start astro dev server
;;
;; Called by site.glitch router or run directly:
;;   glitch run site-dev

(workflow "site-dev"
  :description "Start the astro dev server"

  (step "ensure-dirs"
    (sh "bash" "-c" "mkdir -p site/generated"))

  (step "dev"
    (sh "bash" "-c" "cd site && npx astro dev --port 4322")))
