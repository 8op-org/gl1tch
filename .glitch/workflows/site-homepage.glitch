;; site-homepage.glitch — update the landing page
;;
;; Usage:
;;   glitch run site-homepage "update features to reflect tool-use providers"
;;
;; Uses the search index for context, openrouter for fast rewrite,
;; grounded? for verification, Playwright for integration tests.

(workflow "site-homepage"
  :description "Update the gl1tch homepage (index.astro)"

  (step "context"
    (str
      (search "providers tool-use workflow DSL" :limit 5)
      "\n\n"
      (read-file "site/src/pages/index.astro")))

  (step "rewrite"
    (llm
      :provider "copilot"
      :tools []
      :prompt (str
        "You are updating the gl1tch homepage.\n\n"
        "CURRENT PAGE + CODEBASE CONTEXT:\n" (ref "context") "\n\n"
        "INSTRUCTIONS: " (input) "\n\n"
        "RULES:\n"
        "- Never mention: Ollama, tmux, BubbleTea, OTel, SQLite, 'glitch ask', 'glitch observe'\n"
        "- Voice: user-first, 'your' framing, examples before explanation\n"
        "- Every code example must use real DSL syntax from the context above\n"
        "- Keep all existing CSS class names exactly as they are\n"
        "- Keep the Astro frontmatter exactly as-is\n"
        "- Install command: brew install 8op-org/tap/glitch\n"
        "- Tagline: Shell does the work. LLM does the thinking. You own the workflow.\n\n"
        "Return the complete updated file content for site/src/pages/index.astro.")))

  (step "verify"
    (grounded? "rewrite" (ref "context")
      :provider "openrouter"
      :strict false))

  (step "save"
    (save "site/src/pages/index.astro" (ref "rewrite"))
    "Saved homepage")

  (step "playwright"
    (sh "bash" "-c" "cd site && npx playwright test --reporter=line"))

  (step "dev"
    (sh "bash" "-c" "cd site && npx astro dev --port 4322")))
