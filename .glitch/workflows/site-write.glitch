;; site-write.glitch — create or update a doc page or lab
;;
;; Called by site.glitch router. Not typically run directly.
;; Params: page (slug), instructions (freeform), content-type (optional: "lab" or "doc")
;;
;; Route: openrouter (fast JSON). Write: openrouter (reliable structured output).
;; Gate: openrouter (reliable JSON). Copilot reserved for agentic tool-use only.

(workflow "site-write"
  :description "Write or update a documentation page or lab in EDN hiccup format"

  (step "content-type"
    (or (param "content-type") "doc"))

  (step "content-dir"
    (if (= (ref "content-type") "lab")
      "site/content/labs"
      "site/content/docs"))

  (step "check-existing"
    (sh "bash" "-c"
      (str "f='" (ref "content-dir") "/" (param "page") ".edn'; "
           "if [ -f \"$f\" ]; then cat \"$f\"; else echo '__NEW_PAGE__'; fi")))

  (step "gather-context"
    (sh "bash" "-c"
      (str
        "echo '=== EXISTING EDN DOCS ==='; "
        "for f in site/content/docs/*.edn; do echo \"--- $f ---\"; head -5 \"$f\"; echo; done 2>/dev/null; "
        "echo '=== EXISTING EDN LABS ==='; "
        "for f in site/content/labs/*.edn; do echo \"--- $f ---\"; head -5 \"$f\"; echo; done 2>/dev/null; "
        "echo '=== EXAMPLES ==='; "
        "for f in examples/*.glitch; do echo \"--- $f ---\"; cat \"$f\"; echo; done 2>/dev/null; "
        "echo '=== SOURCE FILES ==='; "
        "head -30 bb/src/glitch/core.clj 2>/dev/null; echo; "
        "head -30 bb/src/glitch/tool_loop.clj 2>/dev/null; echo; "
        "cat bb/src/glitch/mcp/tools.clj 2>/dev/null; echo; "
        "echo '=== PROVIDERS ==='; "
        "for f in bb/providers/*.clj; do echo \"--- $f ---\"; head -20 \"$f\"; echo; done 2>/dev/null; "
        "echo '=== RECENT COMMITS ==='; "
        "git log --oneline -20 2>/dev/null; "
        "echo '=== ALL DOC SLUGS ==='; "
        "for f in site/content/docs/*.edn; do basename \"$f\" .edn; done 2>/dev/null; "
        "echo '=== ALL LAB SLUGS ==='; "
        "for f in site/content/labs/*.edn; do basename \"$f\" .edn; done 2>/dev/null")))

  (step "existing-metadata"
    (sh "bash" "-c"
      (str "f='" (ref "content-dir") "/" (param "page") ".edn'; "
           "if [ -f \"$f\" ]; then "
           "bb -e '(let [d (read-string (slurp \"'\"$f\"'\"))] "
           "(prn {:title (:title d) :order (:order d) :description (:description d) "
           ":date (:date d) :duration (:duration d)}))'; "
           "else echo '__NONE__'; fi")))

  (step "write"
    (llm
      :provider "openrouter"
      :tools []
      :prompt (str
        "You are a technical writer for gl1tch (8op.org).\n\n"
        "VOICE RULES:\n"
        "- \"your\" framing throughout, never \"the user\"\n"
        "- examples before explanation — show real code first, explain second\n"
        "- no internal implementation details: never mention BubbleTea, tmux,\n"
        "  SQLite, Go types, OTel, or any internal package names\n"
        "- every code example must be real — drawn from the CONTEXT below\n"
        "- do NOT invent commands, flags, or features\n"
        "- no glitch ask — it has been decommissioned\n"
        "- no Ollama — LM Studio is the local LLM runtime\n\n"
        "TASK: " (param "instructions") "\n\n"
        "PAGE SLUG: " (param "page") "\n"
        "CONTENT TYPE: " (ref "content-type") "\n\n"
        "EXISTING CONTENT (if updating — __NEW_PAGE__ means create from scratch):\n"
        (ref "check-existing") "\n\n"
        "REPO CONTEXT:\n" (ref "gather-context") "\n\n"
        "EXISTING METADATA:\n" (ref "existing-metadata") "\n\n"
        (if (= (ref "content-type") "lab")
          (str
            "OUTPUT FORMAT: Return a valid EDN map for a lab page.\n"
            "The schema is:\n"
            "{:title \"Lab Title\"\n"
            " :description \"One-line description\"\n"
            " :date \"2026-04-22\"\n"
            " :duration \"15min\"\n"
            " :steps\n"
            " [{:heading \"Step Name\"\n"
            "   :body [[:p \"Explanation text with \" [:code \"inline code\"] \" examples.\"]\n"
            "          [:code {:lang \"clojure\"} \"(some-expression)\"]]}]}\n\n"
            "If updating, preserve existing metadata (title, date, duration) unless told otherwise.\n"
            "Return ONLY the EDN — no markdown fences, no preamble.")
          (str
            "OUTPUT FORMAT: Return a valid EDN map for a doc page.\n"
            "The schema is:\n"
            "{:title \"Page Title\"\n"
            " :description \"One-line description\"\n"
            " :order 5\n"
            " :sections\n"
            " [{:heading \"Section Name\"\n"
            "   :level 2\n"
            "   :body [[:p \"Text with \" [:code \"inline code\"] \" and \" [:a {:href \"#/docs/other\"} \"links\"]]\n"
            "          [:code {:lang \"glitch\"} \"(step \\\"example\\\" (run \\\"echo hi\\\"))\"]]}]}\n\n"
            "HICCUP ELEMENTS you can use:\n"
            "- [:p \"text\" [:code \"inline\"] [:a {:href \"#/docs/slug\"} \"link text\"] [:strong \"bold\"] [:em \"italic\"]]\n"
            "- [:code {:lang \"glitch\"} \"code block content\"] — for code blocks\n"
            "- [:ul [:li \"item\"]] — for lists\n"
            "- [:ol [:li \"item\"]] — for ordered lists\n\n"
            "Cross-links between docs use #/docs/slug format.\n"
            "If updating, preserve existing title/order/description unless told otherwise.\n"
            "Return ONLY the EDN — no markdown fences, no preamble.")))))

  ;; Gate the content (openrouter for reliable JSON)
  (step "gate-result"
    (let [content (ref "write")]
      (llm
        :provider "openrouter"
        :tools []
        :prompt (str
          "Review this documentation page for accuracy.\n\n"
          "Check for:\n"
          "- Banned terms: Ollama, glitch ask, BubbleTea, tmux, OTel, SQLite\n"
          "- Hallucinated commands or flags\n"
          "- Internal implementation details leaking\n"
          "- Valid EDN syntax (maps use {}, vectors use [], keywords use :prefix)\n"
          "- Valid hiccup structure ([:tag attrs? children...])\n\n"
          "PAGE SLUG: " (param "page") "\n"
          "CONTENT TYPE: " (ref "content-type") "\n\n"
          "CONTENT:\n" content "\n\n"
          "Return JSON only: {\"pass\": true, \"issues\": []} or\n"
          "{\"pass\": false, \"issues\": [{\"category\": \"L\", \"fix\": \"description\"}]}\n"
          "Only fail for factual errors or invalid EDN, not style preferences."))))

  ;; Save — log gate issues but don't block
  (step "save"
    (let [gate-out (try (json/decode (json-extract (ref "gate-result")))
                        (catch Exception _ {"pass" true}))
          content (ref "write")]
      (when (not (get gate-out "pass"))
        (binding [*out* *err*]
          (println (str "gate issues:\n"
                        (str/join "\n"
                          (map (fn [issue]
                                 (str "[" (get issue "category") "] " (get issue "fix")))
                               (get gate-out "issues")))))))
      (save (str (ref "content-dir") "/" (param "page") ".edn") content)
      (str "Wrote " (param "page") ".edn"))))
