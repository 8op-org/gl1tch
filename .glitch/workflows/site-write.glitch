;; site-write.glitch — create or update a doc page
;;
;; Called by site.glitch router. Not typically run directly.
;; Params: page (slug), instructions (freeform)
;;
;; Write step uses copilot + MCP (agentic, reads codebase).
;; Route + Gate use openrouter (reliable JSON).

(workflow "site-write"
  :description "Write or update a documentation page"

  (step "check-existing"
    (sh "bash" "-c"
      (str "f='site/src/content/docs/" (param "page") ".md'; "
           "if [ -f \"$f\" ]; then cat \"$f\"; else echo '__NEW_PAGE__'; fi")))

  (step "existing-frontmatter"
    (sh "bash" "-c"
      (str "f='site/src/content/docs/" (param "page") ".md'; "
           "if [ -f \"$f\" ]; then sed -n '/^---$/,/^---$/p' \"$f\"; else echo '__NONE__'; fi")))

  (step "write"
    (llm
      :provider "copilot"
      :agentic true
      :max-rounds 8
      :prompt (str
        "You are a technical writer for gl1tch (8op.org).\n\n"
        "VOICE RULES:\n"
        "- \"your\" framing throughout, never \"the user\"\n"
        "- examples before explanation — show real code first, explain second\n"
        "- no internal implementation details: never mention BubbleTea, tmux,\n"
        "  SQLite, Go types, OTel, or any internal package names\n"
        "- every code example must be real — use glitch_read_file and glitch_grep\n"
        "  to verify commands and parameters exist before referencing them\n"
        "- do NOT invent commands, flags, or features\n"
        "- no glitch ask — it has been decommissioned\n"
        "- no Ollama — LM Studio is the local LLM runtime\n\n"
        "TASK: " (param "instructions") "\n\n"
        "PAGE SLUG: " (param "page") "\n\n"
        "EXISTING CONTENT (if updating — __NEW_PAGE__ means create from scratch):\n"
        (ref "check-existing") "\n\n"
        "EXISTING FRONTMATTER:\n" (ref "existing-frontmatter") "\n\n"
        "Use glitch_read_file to read source files for accurate examples.\n"
        "Use glitch_grep to verify any commands or flags you reference.\n\n"
        "OUTPUT: Return the complete markdown file including frontmatter:\n"
        "---\n"
        "title: \"Page Title\"\n"
        "order: 5\n"
        "description: \"one-line description\"\n"
        "---\n\n"
        "## First heading\n\n"
        "Content here...\n\n"
        "If updating, preserve existing title/order/description unless told otherwise.")))

  ;; Gate the content (openrouter for reliable JSON)
  (step "gate-result"
    (let [content (ref "write")]
      (llm
        :provider "openrouter"
        :tools []
        :prompt (str
          "Review this documentation page for accuracy.\n\n"
          "Check for:\n"
          "- Banned terms: Ollama, glitch ask, BubbleTea, tmux, OTel, SQLite\n"
          "- Hallucinated commands or flags\n"
          "- Internal implementation details leaking\n\n"
          "PAGE SLUG: " (param "page") "\n\n"
          "CONTENT:\n" content "\n\n"
          "Return JSON only: {\"pass\": true, \"issues\": []} or\n"
          "{\"pass\": false, \"issues\": [{\"category\": \"L\", \"fix\": \"description\"}]}\n"
          "Only fail for factual errors, not style preferences."))))

  ;; Save — log gate issues but don't block
  (step "save"
    (let [gate-out (try (json/decode (json-extract (ref "gate-result")))
                        (catch Exception _ {"pass" true}))
          content (ref "write")]
      (when (not (get gate-out "pass"))
        (binding [*out* *err*]
          (println (str "gate issues:\n"
                        (str/join "\n"
                          (map (fn [issue]
                                 (str "[" (get issue "category") "] " (get issue "fix")))
                               (get gate-out "issues")))))))
      (save (str "site/src/content/docs/" (param "page") ".md") content)
      (str "Wrote " (param "page") ".md"))))
