# site-write.glitch — create or update a doc page
#
# Called by site.glitch router. Not typically run directly.
# Params: page (slug), instructions (freeform)

(import glitch/core :as g)

(g/workflow "site-write"
  :description "Write or update a documentation page"

  (g/step "check-existing"
    (g/sh "bash" "-c"
      (string "f='site/src/content/docs/" (g/param "page") ".md'; "
              "if [ -f \"$f\" ]; then cat \"$f\"; else echo '__NEW_PAGE__'; fi")))

  (g/step "gather-context"
    (g/sh "bash" "-c"
      (string
        "echo '=== DOC STUBS ==='; "
        "for f in docs/site/*.md; do echo \"--- $f ---\"; cat \"$f\"; echo; done 2>/dev/null; "
        "echo '=== EXAMPLES ==='; "
        "for f in examples/*.glitch; do echo \"--- $f ---\"; cat \"$f\"; echo; done 2>/dev/null; "
        "echo '=== RECENT COMMITS ==='; "
        "git log --oneline -20 -- janet/ examples/ docs/site/ .glitch/ 2>/dev/null; "
        "echo '=== ALL PAGE SLUGS ==='; "
        "for f in site/src/content/docs/*.md; do basename \"$f\" .md; done 2>/dev/null")))

  (g/step "existing-frontmatter"
    (g/sh "bash" "-c"
      (string "f='site/src/content/docs/" (g/param "page") ".md'; "
              "if [ -f \"$f\" ]; then sed -n '/^---$/,/^---$/p' \"$f\"; else echo '__NONE__'; fi")))

  (g/step "write"
    (g/llm
      :provider "copilot"
      :format "json"
      :prompt (string ```
        You are a technical writer for gl1tch (8op.org).

        VOICE RULES:
        - "your" framing throughout, never "the user"
        - examples before explanation — show real code first, explain second
        - no internal implementation details: never mention BubbleTea, tmux,
          SQLite, Go types, OTel, or any internal package names
        - every code example must be real — drawn from the CONTEXT below
        - do NOT invent commands, flags, or features
        - no glitch ask — it has been decommissioned
        - no Ollama — LM Studio is the local LLM runtime

        TASK: ``` (g/param "instructions") ```

        PAGE SLUG: ``` (g/param "page") ```

        EXISTING CONTENT (if updating — __NEW_PAGE__ means create from scratch):
        ``` (g/ref "check-existing") ```

        REPO CONTEXT:
        ``` (g/ref "gather-context") ```

        OUTPUT: A single JSON object, no markdown fence:
        {
          "title": "Page Title",
          "order": 5,
          "description": "one-line description for frontmatter",
          "content": "full markdown body starting with ## heading, no frontmatter"
        }

        If updating an existing page, preserve the current title/order/description
        from the existing frontmatter unless the instructions say otherwise.

        EXISTING FRONTMATTER:
        ``` (g/ref "existing-frontmatter") ```
        ```)))

  # Gate the content before saving
  (g/step "gate-result"
    (do
      (def written (json/decode (g/ref "write")))
      (def result (g/call-workflow "site-gate"
                    :set {"slug" (g/param "page")
                          "content" (written "content")
                          "context" (g/ref "gather-context")}))
      (result :output)))

  # Save if gate passed
  (g/step "save"
    (do
      (def gate-out (json/decode (g/ref "gate-result")))
      (when (not (gate-out "pass"))
        (error (string "Gate failed:\n"
                       (string/join
                         (map |(string "[" ($ "category") "] " ($ "fix"))
                              (gate-out "issues"))
                         "\n"))))
      (def written (json/decode (g/ref "write")))
      (def title (written "title"))
      (def order (written "order"))
      (def desc (written "description"))
      (def content (written "content"))
      (def frontmatter
        (string "---\n"
                "title: \"" title "\"\n"
                "order: " order "\n"
                "description: \"" desc "\"\n"
                "---\n\n"))
      (g/save (string "site/src/content/docs/" (g/param "page") ".md")
              (string frontmatter content))
      (string "Wrote " (g/param "page") ".md"))))
