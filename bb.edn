{:tasks
 {build   {:doc "Build the glitch uberscript"
           :task (shell {:dir "bb"} "bb build")}
  test    {:doc "Run tests"
           :task (shell {:dir "bb"} "bb test")}
  install {:doc "Build and install glitch to ~/.local/bin"
           :task (shell {:dir "bb"} "bb install")}
  clean   {:doc "Clean build artifacts"
           :task (shell {:dir "bb"} "bb clean")}
  site:dev   {:doc "Run Astro dev server"
              :task (shell {:dir "site"} "npm run dev")}
  site:build {:doc "Build the 8op.org site"
              :task (shell {:dir "site"} "npm run build")}
  dev:setup   {:doc "Verify dev environment dependencies"
               :task (shell "glitch run dev/workflows/dev-setup.glitch")}
  dev:docs    {:doc "Generate documentation from source"
               :task (shell "glitch run dev/workflows/dev-docs.glitch")}
  dev:release {:doc "Build, test, and generate release changelog"
               :task (shell "glitch run dev/workflows/dev-release.glitch")}
  dev:review  {:doc "LLM review of uncommitted changes"
               :task (shell "glitch run dev/workflows/dev-review.glitch")}}}
